# ==============================================================================
# CẤU HÌNH HỆ THỐNG CHUYÊN VIÊN ẢO VĂN PHÒNG ĐẢNG UỶ XÃ CÔNG HẢI
# ==============================================================================

# --- ĐỘNG CƠ AI KÉP (DUAL-ENGINE ARCHITECTURE) ---
# 1. ĐỘNG CƠ CHÍNH (PRIMARY): Google Gemini Flash (https://aistudio.google.com)
# Miễn phí 500 lượt/ngày, 250K TPM, tốc độ siêu tốc, context window 1 triệu token.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# 2. ĐỘNG CƠ DỰ PHÒNG (FALLBACK): DeepSeek Cloud API (https://platform.deepseek.com)
# Tự động kích hoạt khi Gemini chạm hạn ngạch (429) hoặc mạng gián đoạn.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# 3. NHÀ CUNG CẤP ƯU TIÊN MẶC ĐỊNH: "gemini" (Khuyên dùng), "cloud" (DeepSeek), hoặc "local" (Ollama Offline)
AI_PROVIDER=gemini

# --- CẤU HÌNH MÁY CHỦ WEB LOCAL / VPS ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG=True

# --- THÔNG TIN ĐƠN VỊ ĐẢNG BỘ XÃ CÔNG HẢI ---
CO_QUAN_CAP_TREN=ĐẢNG BỘ TỈNH KHÁNH HOÀ
CO_QUAN_BAN_HANH=ĐẢNG UỶ XÃ CÔNG HẢI
VAN_PHONG_NAME=VĂN PHÒNG
DIA_DANH=Công Hải
NAM_HIEN_TAI=2026

# --- CẤU HÌNH ZALO THÔNG BÁO TỰ ĐỘNG ---
ZALO_API_TOKEN=
ZALO_WEBHOOK_SECRET=
ADMIN_ZALO_IDS=
SERVER_DOMAIN=

# --- CẤU HÌNH GOOGLE DRIVE LƯU TRỮ VĂN BẢN DỰ THẢO ---
GDRIVE_FOLDER_ID=1IhUuenISqXs_KeSkWqSI_5423DNstxGF
GDRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1IhUuenISqXs_KeSkWqSI_5423DNstxGF?usp=sharing
GDRIVE_WEB_APP_URL=
